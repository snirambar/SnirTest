# WhatsApp MCP connector configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Required ---------------------------------------------------------------

# System user access token from the Meta App dashboard.
# Needs the whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=

# Phone number ID of the sending number.
# WhatsApp Manager > Account tools > Phone numbers. This is the numeric ID,
# NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# --- Required to receive messages -------------------------------------------
# Both are required unless WHATSAPP_WEBHOOK_PORT=0 (send-only mode).

# App secret from Meta App dashboard > App settings > Basic.
# Used to verify the HMAC signature on every inbound webhook.
WHATSAPP_APP_SECRET=

# A random string you choose. Enter the same value as the "Verify token" when
# registering the callback URL in the Meta App dashboard.
WHATSAPP_VERIFY_TOKEN=

# --- Optional ---------------------------------------------------------------

# Graph API version. The built-in default ages out as Meta ships new versions;
# set this to override without a code change.
# WHATSAPP_GRAPH_API_VERSION=v21.0

# Port for the inbound webhook listener. Set to 0 to disable it (send-only).
# WHATSAPP_WEBHOOK_PORT=3000

# Interface to bind. Defaults to loopback; the listener expects a tunnel or
# reverse proxy in front of it rather than facing the internet directly.
# WHATSAPP_WEBHOOK_HOST=127.0.0.1

# Path the listener serves. Must match the callback URL registered with Meta.
# WHATSAPP_WEBHOOK_PATH=/webhook

# Safety guard. When set, sends to any number not listed here are refused.
# Strongly recommended while developing against a live business number.
# WHATSAPP_ALLOWED_RECIPIENTS=+15550101234,+15550105678

# How many inbound events to keep in memory before evicting the oldest.
# WHATSAPP_INBOX_SIZE=500
